# Database Connection String (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/jobportal?retryWrites=true&w=majority

# Server Configuration
PORT=8000
NODE_ENV=production
SECRET_KEY=your_super_secret_jwt_key_here

# Frontend URL (for CORS and cookies)
FRONTEND_URL=https://your-frontend.vercel.app

# Cloudinary Configuration (for uploading profile pictures and resumes)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
